{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "lint": "eslint \"client/src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"shared/**/*.ts\"",
    "doctor": "bash scripts/doctor.sh",
    "repair:win-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/repair-windows-install.ps1",
    "docs:validate": "node scripts/validate-readme.mjs",
    "test:runtime": "bash scripts/test-runtime.sh",
    "test:contracts": "tsx scripts/test-api-contract.ts",
    "test:login": "tsx scripts/test-login.ts",
    "test:rbac": "tsx scripts/test-rbac.ts",
    "test:requisitions": "tsx scripts/test-requisitions.ts",
    "test:procurement-flow": "tsx scripts/test-procurement-flow.ts",
    "test:master-data-propagation": "tsx scripts/test-master-data-propagation.ts",
    "test:master-data-integration": "tsx scripts/test-master-data-integration.ts",
    "test:ap-workflow": "tsx scripts/test-ap-workflow.ts",
    "test:ap-controls": "tsx scripts/test-ap-controls.ts",
    "test:supplier-portal": "tsx scripts/test-supplier-portal.ts",
    "test:exports": "tsx scripts/test-exports.ts",
    "test:smoke": "tsx scripts/test-smoke.ts",
    "test:stabilization-client": "tsx scripts/test-stabilization-client.ts",
    "test:diagnostics": "tsx scripts/test-diagnostics-self-checks.ts",
    "test:route-diagnostics": "tsx scripts/test-route-diagnostics.ts",
    "test:security-hardening": "node scripts/test-security-hardening.mjs",
    "test:first-run-onboarding": "node scripts/test-first-run-onboarding.mjs",
    "test:plan-connection-hardening": "node scripts/test-plan-connection-hardening.mjs",
    "test:local": "node scripts/run-local-tests.mjs",
    "test:local:delta": "node scripts/run-local-tests.mjs --delta",
    "test:local:no-server": "node scripts/run-local-tests.mjs --no-server",
    "test:local:browser": "node scripts/run-local-browser-walkthrough.mjs",
    "test:codespace:browser": "node scripts/run-remote-browser-walkthrough.mjs",
    "test:po-print-html": "tsx scripts/test-po-print-html.ts",
    "test:purchase-order-status": "tsx scripts/test-purchase-order-status.ts",
    "test:purchase-order-endpoints": "tsx scripts/test-purchase-order-endpoints.ts",
    "test:dashboard-data": "tsx scripts/test-dashboard-data.ts",
    "test:logistics-filters": "tsx scripts/test-logistics-filters.ts",
    "test:logistics-write-guards": "node scripts/test-logistics-write-guards.mjs",
    "test:exceptions-workflow": "tsx scripts/test-exceptions-workflow.ts",
    "test:control-tower-dashboard": "tsx scripts/test-control-tower-dashboard.ts",
    "test:purchase-order-actions-e2e": "cross-env PLAYWRIGHT_REUSE_EXISTING_SERVER=1 npx playwright test e2e/purchase-order-actions.spec.ts",
    "test:dashboard-e2e": "cross-env PLAYWRIGHT_REUSE_EXISTING_SERVER=1 npx playwright test e2e/dashboard.spec.ts",
    "test:functional-calculations": "tsx scripts/test-functional-calculations.ts",
    "test:po-receive-qty": "tsx scripts/test-po-receive-qty-rules.ts",
    "test:po-feature-queries": "tsx scripts/test-po-feature-queries.ts",
    "test:functional-filters": "tsx scripts/test-functional-filters.ts",
    "test:functional-inventory-api": "tsx scripts/test-functional-inventory-api.ts",
    "test:functional-audit": "npm run test:functional-calculations && npm run test:functional-filters && npm run test:functional-e2e",
    "seed:functional-qa": "tsx server/seed-functional-qa.ts",
    "test:setup-checkpoint": "tsx scripts/test-setup-product-checkpoint.ts",
    "test:installable-complete": "tsx scripts/test-installable-setup-complete.ts",
    "test:installable-org-bootstrap": "tsx scripts/test-installable-org-bootstrap.ts",
    "test:api": "npm run test:rbac && npm run test:requisitions && npm run test:procurement-flow && npm run test:supplier-portal && npm run test:exports && npm run test:org-api",
    "test:deeplinks": "tsx scripts/test-kpi-deeplinks.ts",
    "test:org-isolation": "tsx scripts/test-org-isolation.ts",
    "test:org-api": "tsx scripts/test-org-api-isolation.ts",
    "test:inventory-port": "tsx scripts/test-inventory-port.ts",
    "test:csv": "tsx server/services/document-generator-service.test.ts",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:functional-e2e": "cross-env PLAYWRIGHT_REUSE_EXISTING_SERVER=1 npx playwright test e2e/functional-audit.spec.ts",
    "test:requisition-supplier-e2e": "cross-env PLAYWRIGHT_REUSE_EXISTING_SERVER=1 npx playwright test e2e/requisitions-supplier-portal.spec.ts",
    "verify:core": "npm run check && npm run test:stabilization-client && npm run test:diagnostics && npm run test:route-diagnostics && npm run test:po-print-html && npm run test:purchase-order-status && npm run test:po-receive-qty && npm run test:po-feature-queries && npm run test:functional-audit && npm run test:e2e",
    "verify:release": "npm run verify:core && npm run test:purchase-order-actions-e2e",
    "test:e2e:preflight": "node scripts/e2e-preflight.mjs",
    "playwright:install-deps": "playwright install-deps",
    "verify:changes": "node scripts/verify-recent-changes.js",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "verify:package-manifests": "node scripts/verify-package-manifests-clean.mjs",
    "migrate:check": "node scripts/migrate-check.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release:gate:delta": "npm run test:rbac && npm run test:requisitions && npm run test:ap-workflow && npm run test:ap-controls && npm run test:exports && npm run test:smoke && npm run test:setup-checkpoint && npm run test:installable-complete",
    "test:endpoints": "node scripts/test-button-endpoints.js http://127.0.0.1:5000",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:seed": "tsx server/seed.ts",
    "seed:operational": "tsx server/seed-operational.ts",
    "demo:reset": "tsx server/seed.ts --reset && tsx server/seed-operational.ts",
    "db:repair": "tsx scripts/db-repair.ts",
    "db:ensure-installable-app-settings": "tsx scripts/ensure-app-settings-installable-columns.ts",
    "e2e:prep": "tsx scripts/e2e-prep-product-onboarding.ts",
    "codespaces:up": "bash scripts/codespaces-up.sh",
    "codespaces:doctor": "bash scripts/codespaces-doctor.sh",
    "codespaces:ports-public": "bash scripts/codespaces-make-port-public.sh",
    "codespaces:port:reset": "bash scripts/codespaces-port-reset.sh",
    "doctor:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-doctor.ps1",
    "security:lifecycle": "node scripts/list-lifecycle-scripts.mjs",
    "security:lifecycle:enforce": "node scripts/list-lifecycle-scripts.mjs --enforce",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:signatures": "npm audit signatures",
    "security:sbom": "npm sbom --sbom-format cyclonedx --package-lock-only > sbom.cdx.json",
    "security:supply-chain": "npm run security:lifecycle:enforce && npm run security:sbom && npm run security:audit:signatures && npm run security:audit",
    "security:supply-chain:ci": "npm run verify:package-manifests && npm run security:supply-chain",
    "build:secure": "npm run check && npm run lint && npm run validate:migrations && npm run security:supply-chain && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
