# ISS Sourcing — environment variables for local development and production
# Copy to .env and fill in values. Never commit .env to version control.

# Database (required for full functionality)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://username:password@localhost:5432/iss_sourcing

# Or use individual PG variables instead of DATABASE_URL:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=iss_sourcing
# PGUSER=postgres
# PGPASSWORD=yourpassword

# Session secret (required in production; use a long random string)
SESSION_SECRET=change-me-to-a-long-random-secret-in-production

# Optional: reject login when password is older than N days (requires users.last_password_change set)
# PASSWORD_MAX_AGE_DAYS=90

# Optional: run operational exception checks on an interval (minutes, minimum 5). Same logic as POST /api/exceptions/run-checks
# OPERATIONAL_EXCEPTION_SCAN_INTERVAL_MINUTES=60

# Server
HOST=0.0.0.0
PORT=5000
# Vite dev client (Codespaces / proxy — keep aligned with PORT in dev)
CLIENT_PORT=5000
# Default Postgres port (devcontainer `db` service / local Docker)
DB_PORT=5432

# Optional: auto-seed demo data when database is empty (default: true in dev, false in production)
# AUTO_SEED_ON_EMPTY_DB=true

# Optional: email (for purchase order emails, etc.)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=noreply@example.com
# Skip mirroring in-app notifications to email (default: send when transporter is configured)
# DISABLE_NOTIFICATION_EMAIL=true

# Optional: SMS via Twilio (mirrors selected in-app notifications to SMS when user has phone set)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
# Skip SMS mirror entirely
# DISABLE_NOTIFICATION_SMS=true
# Dev: log SMS payloads instead of sending (when Twilio is not configured)
# SMS_LOG=true
