NODE_ENV=development

# App ports
# Server and client are served through the same Express process in this project.
PORT=5000
CLIENT_PORT=5000
DB_PORT=5432

# PostgreSQL defaults (local non-Codespaces)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_dev
PGHOST=localhost
PGPORT=5432
PGDATABASE=inventory_dev
PGUSER=postgres
PGPASSWORD=postgres

# Codespaces DB reference (do not enable locally unless using the devcontainer DB service)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/inventory_dev
# PGHOST=db

# Application defaults
BASE_URL=http://localhost:5000
SESSION_SECRET=change-me-for-local-development
AUTO_SEED_ON_EMPTY_DB=true

# Optional integrations
# OPENAI_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=
