NODE_ENV=development
PORT=5000

# Local default PostgreSQL settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_dev
PGHOST=localhost
PGPORT=5432
PGDATABASE=inventory_dev
PGUSER=postgres
PGPASSWORD=postgres

# Application defaults for local development
BASE_URL=http://localhost:5000
SESSION_SECRET=change-me-for-local-development

